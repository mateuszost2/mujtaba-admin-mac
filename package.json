{
  "name": "mujtaba-admin",
  "version": "1.0.0",
  "description": "Admin panel for Mujtaba Manzoor portfolio",
  "main": "main.js",
  "engines": {
    "node": ">=16.20.2"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:zip": "electron-builder --win --config.win.target=zip",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^10.0.3"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.mujtaba.admin",
    "productName": "Mujtaba Admin",
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ]
  },
  "allowScripts": {
    "electron@29.4.6": true,
    "ssh2@1.17.0": true
  }
}
